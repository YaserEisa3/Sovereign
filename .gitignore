# --- Unity generated folders (large, machine-specific, always regenerated) ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files for ignored folders
!/[Aa]ssets/**/*.meta

# --- Visual Studio / Rider / VS Code ---
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Build artefacts ---
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# --- Local verification logs ---
*.log

# Unity crash-recovery scenes (regenerated, not project content)
[Aa]ssets/_Recovery/
