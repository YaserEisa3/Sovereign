<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Sovereign.uss" />
    <ui:VisualElement name="panel-trade-currency" class="drawer">
        <ui:VisualElement class="drawer-header">
            <ui:Label text="TRADE" class="panel-heading" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="close-panel" text="X" class="close-btn" />
        </ui:VisualElement>
        <ui:ScrollView name="trade-scroll" class="drawer-body">
            <ui:Label text="TARIFFS" class="section-heading" />
            <ui:VisualElement name="tariff-list" class="policy-list" />
            <ui:Label text="PER-NATION TARIFFS" class="section-heading" />
            <ui:VisualElement name="nation-tariff-list" class="policy-list" />
            <ui:Label name="retaliation-warning" text="" class="mono warning-text" />

            <ui:Label text="AGREEMENTS" class="section-heading" />
            <ui:VisualElement name="agreement-list" class="policy-list" />

            <ui:Label text="WHAT THE COUNTRY MAKES" class="section-heading" />
            <ui:Label name="production-summary" text="--" class="mono strong" />
            <ui:VisualElement name="production-list" class="policy-list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
