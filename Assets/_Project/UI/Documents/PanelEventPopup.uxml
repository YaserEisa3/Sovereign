<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Sovereign.uss" />
    <ui:VisualElement name="panel-event-popup" class="popup-root">
        <ui:VisualElement name="popup-card" class="popup-card">
            <ui:VisualElement class="row">
                <ui:Label name="popup-category" text="CATEGORY" class="caption" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="popup-severity" text="" class="mono flag" />
            </ui:VisualElement>
            <ui:Label name="popup-title" text="Event Title" class="popup-title" />
            <ui:Label name="popup-description" text="" class="popup-body" />
            <ui:Label name="popup-footnote" text="Respond through your policy controls. There is no menu of choices here." class="caption" />
            <ui:VisualElement class="row">
                <ui:VisualElement class="spacer" />
                <ui:Button name="popup-open-panel" text="Open relevant panel" class="drawer-btn" />
                <ui:Button name="popup-dismiss" text="Acknowledge" class="drawer-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
